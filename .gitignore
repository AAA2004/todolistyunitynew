# Unity3D generated meta files for ignored files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# macOS specific junk files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# iOS / Android Build files
*.apk
*.aab
*.app
Pods/
Podfile.lock
